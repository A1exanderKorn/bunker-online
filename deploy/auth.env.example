# On Linux VPS add these settings to the existing root .env (preserve SITE_ADDRESS).
# Compose uses ':' between files on Linux; do not copy this value to Windows.
COMPOSE_FILE=compose.yaml:compose.auth.yaml
SITE_ADDRESS=vbunkere.online
APP_ORIGIN=https://vbunkere.online
# Generate 32 random bytes as hex, never commit the resulting value.
POSTGRES_PASSWORD=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
