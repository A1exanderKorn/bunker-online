# Зависимости
# Устанавливаются через npm ci; не храним их ни в корне, ни во вложенных пакетах.
node_modules/
**/node_modules/

# Сборка
dist/
build/
*.tsbuildinfo

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Окружение
.env
.env.*
!.env.example

# Редакторы / ОС
.DS_Store
Thumbs.db
*.local

# IDE (кроме общих рекомендаций расширений при желании)
.vscode/*
!.vscode/extensions.json
.idea/

# Локальные спеки и правила Cursor (не коммитить)
.cursor/
.deploy/
.history-outbox/
**/.history-outbox/

# Локальные отчёты
/reports/
